<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>LakeUI.Notifications</Title>
    <Authors>1059 Studio</Authors>
    <Description>专为 WinForms VB 项目特别封装的 Win10/Win11 Windows App Notification。此扩展包不需要 LakeUI 本体，可单独使用。</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
	<AssemblyVersion>1.0.0</AssemblyVersion>
	<FileVersion>1.0.0</FileVersion>
	<Version>1.0.0</Version>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://lakeui.top</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lake1059/LakeUI</RepositoryUrl>
    <PackageTags>winforms;notifications;toast;windows-app-sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)'=='true'">
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsAotCompatible>True</IsAotCompatible>
    <IsTrimmable>True</IsTrimmable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
    <IsAotCompatible>True</IsAotCompatible>
    <IsTrimmable>True</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.0.21" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Build\LakeUI.Notifications.props" Pack="true" PackagePath="buildTransitive\LakeUI.Notifications.props" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- WinAppSDK 的 MakePri 按 <rid> 子目录收集引用项目的 .pri，而 dotnet publish 的
       RuntimeIdentifier 不会传给 ProjectReference（附加到 ProjectReference 的
       AdditionalProperties 也会被 SDK 的全局属性剥离），类库仍输出到无 RID 的
       bin\<tfm>\，于是 WINAPPSDKGENERATEPROJECTPRIFILE 报 PRI175/PRI252。
       见 microsoft/WindowsAppSDK#6439。仅在单文件发布时让本库跟随 RID 输出，
       日常 build/pack 行为不变。发布其他架构时把 win-x64 换成对应 RID。 -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
